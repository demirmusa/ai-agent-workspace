# Generated by ai-agent-workspace. PR content is data, never host code.
name: AIWS PR review
on:
  pull_request_target:
    types: [opened, synchronize, reopened, ready_for_review]
  workflow_dispatch:
    inputs:
      pr_number:
        description: Pull request number to review
        required: true
        type: string
permissions:
  contents: read
  pull-requests: write
concurrency:
  group: "{{CONCURRENCY_GROUP}}-review-${{ inputs.pr_number || github.event.pull_request.number }}"
  cancel-in-progress: false
jobs:
  review:
    if: >-
      ${{
        (github.event_name == 'workflow_dispatch' || ({{REVIEW_AUTOMATIC}} && !github.event.pull_request.draft)) &&
        (contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), '*') || contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), github.actor)) &&
        (github.event_name == 'workflow_dispatch' || github.event.pull_request.head.repo.full_name == github.repository)
      }}
    runs-on: {{RUNNER_LABELS}}
    timeout-minutes: {{REVIEW_TIMEOUT_MINUTES}}
    env:
      AIWS_EXPECTED_RUNTIME_VERSION: "{{RUNTIME_VERSION}}"
      AIWS_PR_NUMBER: ${{ inputs.pr_number || github.event.pull_request.number }}
      AIWS_AUTOMATION_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
      GH_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
    steps:
      - name: Verify trusted runtime
        run: /opt/aiws/bin/runtime-check.sh
      - name: Review pull request
        run: /opt/aiws/bin/review-run.sh
