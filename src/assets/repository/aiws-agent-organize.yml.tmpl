# Generated by ai-agent-workspace. Trusted runtime only.
name: AIWS organize
run-name: "AIWS organize #${{ inputs.issue_number }} [${{ inputs.dispatch_id }}]"
on:
  workflow_dispatch:
    inputs:
      issue_number:
        description: Issue to organize
        required: true
        type: string
      dispatch_id:
        description: Scheduler reservation identity
        required: false
        type: string
permissions:
  contents: read
  issues: write
concurrency:
  group: "{{CONCURRENCY_GROUP}}-organization"
  cancel-in-progress: false
jobs:
  organize:
    if: >-
      ${{ contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), '*') || contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), github.actor) }}
    runs-on: {{RUNNER_LABELS}}
    timeout-minutes: {{ISSUE_TIMEOUT_MINUTES}}
    env:
      AIWS_EXPECTED_RUNTIME_VERSION: "{{RUNTIME_VERSION}}"
      AIWS_ISSUE_NUMBER: ${{ inputs.issue_number }}
      AIWS_AUTOMATION_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
      GH_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
{{PROJECT_TOKEN_ENV}}
    steps:
      - name: Verify trusted runtime
        run: /opt/aiws/bin/runtime-check.sh
      - name: Organize dependencies and promote ready tasks
        run: /opt/aiws/bin/organize.sh
