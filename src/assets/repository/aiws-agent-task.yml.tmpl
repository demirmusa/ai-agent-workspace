# Generated by ai-agent-workspace. Changes will be replaced by `aiws sync`.
# This workflow deliberately does not check out or execute scripts from the repository.
name: AIWS agent task
run-name: "AIWS issue #${{ inputs.issue_number || github.event.issue.number }} [${{ inputs.dispatch_id }}]"

on:
  workflow_dispatch:
    inputs:
      issue_number:
        description: Issue number reserved by the scheduler
        required: true
        type: string
      dispatch_id:
        description: Scheduler reservation identity
        required: false
        type: string
  issues:
    types: [labeled]
  issue_comment:
    types: [created]

permissions:
  contents: write
  issues: write
  pull-requests: write

concurrency:
  group: "{{CONCURRENCY_GROUP}}-issue-${{ inputs.issue_number || github.event.issue.number }}"
  cancel-in-progress: false

jobs:
  run:
    if: >-
      ${{
        (
          contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), '*') ||
          contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), github.actor)
        ) &&
        !contains(github.event.issue.body, '<!-- aiws-task:') &&
        (
          github.event_name == 'workflow_dispatch' ||
          (
            github.event_name == 'issues' &&
            contains(fromJSON('{{AGENT_LABELS_JSON}}'), github.event.label.name)
          ) ||
          (
            github.event_name == 'issue_comment' &&
            github.event.issue.pull_request == null &&
            (
              github.event.comment.body == '{{AGENT_COMMAND}}' ||
              startsWith(github.event.comment.body, '{{AGENT_COMMAND}} ')
            )
          )
        )
      }}
    runs-on: {{RUNNER_LABELS}}
    timeout-minutes: {{ISSUE_TIMEOUT_MINUTES}}
    env:
      AIWS_EXPECTED_RUNTIME_VERSION: "{{RUNTIME_VERSION}}"
      AIWS_QUEUE_MODE: ${{ github.event_name == 'workflow_dispatch' && 'scheduled' || '' }}
      AIWS_ISSUE_NUMBER: ${{ inputs.issue_number }}
      AIWS_AUTOMATION_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
      GH_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
{{PROJECT_TOKEN_ENV}}
    steps:
      - name: Verify the trusted AIWS runtime
        run: /opt/aiws/bin/runtime-check.sh

      - name: Run the issue agent
        run: /opt/aiws/bin/issue-run.sh
