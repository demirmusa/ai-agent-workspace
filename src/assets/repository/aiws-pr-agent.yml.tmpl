# Generated by ai-agent-workspace. Changes will be replaced by `aiws sync`.
# This workflow deliberately does not check out or execute scripts from the repository.
name: AIWS pull request agent

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

permissions:
  contents: write
  issues: write
  pull-requests: write

concurrency:
  group: "{{CONCURRENCY_GROUP}}-pr-${{ github.event.issue.number || github.event.pull_request.number }}"
  cancel-in-progress: false

jobs:
  run:
    if: >-
      ${{
        (
          contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), '*') ||
          contains(fromJSON('{{ACTOR_ALLOWLIST_JSON}}'), github.actor)
        ) &&
        (
          github.event.comment.body == '{{PR_COMMAND}}' ||
          startsWith(github.event.comment.body, '{{PR_COMMAND}} ')
        ) &&
        (
          github.event_name == 'pull_request_review_comment' ||
          (
            github.event_name == 'issue_comment' &&
            github.event.issue.pull_request != null
          )
        )
      }}
    runs-on: {{RUNNER_LABELS}}
    timeout-minutes: {{PR_TIMEOUT_MINUTES}}
    env:
      AIWS_EXPECTED_RUNTIME_VERSION: "{{RUNTIME_VERSION}}"
      AIWS_AUTOMATION_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
      GH_TOKEN: ${{ secrets['{{AUTOMATION_TOKEN_SECRET}}'] || github.token }}
    steps:
      - name: Verify the trusted AIWS runtime
        run: /opt/aiws/bin/runtime-check.sh

      - name: Run the pull request agent
        run: /opt/aiws/bin/pr-run.sh
